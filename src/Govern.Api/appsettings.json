{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "govern-api",
    "Audience": "govern-client",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "MaxActiveRefreshTokens": 10
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00",
    "HealthPermitLimit": 30,
    "HealthWindow": "00:01:00",
    "GamesPermitLimit": 20,
    "GamesWindow": "00:01:00",
    "GameCommandsPermitLimit": 120,
    "GameCommandsWindow": "00:01:00"
  },
  "HostFiltering": {
    "AllowedHosts": []
  },
  "SignInThrottling": {
    "MaxFailedAttempts": 5,
    "Window": "00:15:00",
    "MaxTrackedAccounts": 100000
  }
}
