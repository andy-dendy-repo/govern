# Local manual testing. Secrets come from user-secrets (see docs/operations/local-development.md).
@api = http://localhost:5153
@email = someone@example.com
@password = Pa$$w0rd-123
@email2 = opponent@example.com

### Sign up
POST {{api}}/api/users/sign-up
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Sign in
# @name signIn
POST {{api}}/api/users/sign-in
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Who am I
GET {{api}}/api/users/me
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Refresh (rotates the sign-in refresh token)
# @name refresh
POST {{api}}/api/users/refresh
Content-Type: application/json

{ "refreshToken": "{{signIn.response.body.$.refreshToken}}" }

### Sign out (this device)
POST {{api}}/api/users/sign-out
Authorization: Bearer {{refresh.response.body.$.accessToken}}
Content-Type: application/json

{ "refreshToken": "{{refresh.response.body.$.refreshToken}}" }

### Sign out everywhere
POST {{api}}/api/users/sign-out-everywhere
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Games: sign up and sign in the second player
POST {{api}}/api/users/sign-up
Content-Type: application/json

{ "email": "{{email2}}", "password": "{{password}}" }

###
# @name signIn2
POST {{api}}/api/users/sign-in
Content-Type: application/json

{ "email": "{{email2}}", "password": "{{password}}" }

### Create a game (first player; returns the invite code)
# @name createGame
POST {{api}}/api/games
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Join with the invite code (second player)
POST {{api}}/api/games/join
Authorization: Bearer {{signIn2.response.body.$.accessToken}}
Content-Type: application/json

{ "inviteCode": "{{createGame.response.body.$.inviteCode}}" }

### Start (creator only; returns the creator's view)
# @name startGame
POST {{api}}/api/games/{{createGame.response.body.$.id}}/start
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Live updates as the first player (server-sent events: `game` snapshots and `heartbeat`s; run it in a terminal with
### curl -N -H "Authorization: Bearer <token>" to keep it open while you send commands below)
GET {{api}}/api/games/{{createGame.response.body.$.id}}/stream
Authorization: Bearer {{signIn.response.body.$.accessToken}}
Accept: text/event-stream

### End the first turn (expectedVersion = the view.version you last saw; it is per player and opaque)
POST {{api}}/api/games/{{createGame.response.body.$.id}}/commands
Authorization: Bearer {{signIn.response.body.$.accessToken}}
Content-Type: application/json

{ "expectedVersion": {{startGame.response.body.$.view.version}}, "command": { "type": "end_turn" } }

### Get the game as the first player
GET {{api}}/api/games/{{createGame.response.body.$.id}}
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Get the game as the second player (a different fog-of-war view, with its own view.version)
# @name getGame2
GET {{api}}/api/games/{{createGame.response.body.$.id}}
Authorization: Bearer {{signIn2.response.body.$.accessToken}}

### Move a unit as the second player (ids are random: pick a unit id and a target from view.units / view.tiles)
POST {{api}}/api/games/{{createGame.response.body.$.id}}/commands
Authorization: Bearer {{signIn2.response.body.$.accessToken}}
Content-Type: application/json

{ "expectedVersion": {{getGame2.response.body.$.view.version}}, "command": { "type": "move_unit", "unitId": { "value": 123456 }, "target": { "q": 3, "r": 3 } } }

### List my games
GET {{api}}/api/games?page=1&pageSize=20
Authorization: Bearer {{signIn.response.body.$.accessToken}}

### Liveness (no dependencies; the App Service Health check path)
GET {{api}}/health/live

### Readiness (database; rate limited per IP)
GET {{api}}/health/ready
