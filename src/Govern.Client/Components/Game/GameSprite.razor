@* The game's icon set: one <symbol> per unit id, terrain id, the city and each UI glyph, rendered once per game screen.
   Every <svg> on the page draws an icon with <use href="#id"> (GameIcon, the board). Ids come from Helpers/Icons.
   A new ruleset unit or terrain adds its symbol here (GameSpriteTests fails until it does). Shapes sit in a 26x26 box
   centred on 0,0; the fill comes from the <use> (a seat or terrain colour), the white mark from .icon-mark. A terrain symbol is
   its hex (in the terrain colour) plus a .terrain-mark drawing; the board draws it on each tile of that terrain, where the
   hex blends into the tile and only the drawing shows. *@

<svg class="game-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
        <symbol id="city" overflow="visible">
            <path d="M-13,10 V-4 H-9 V-9 H-4 V-4 H4 V-9 H9 V-4 H13 V10 Z"/>
        </symbol>
        <symbol id="unit-settler" overflow="visible">
            <circle r="9"/>
            <path class="icon-mark" d="M-3,6 V-6 L5,-3 L-3,0"/>
        </symbol>
        <symbol id="unit-soldier" overflow="visible">
            <path d="M0,-11 L10,-6 V2 C10,7 5,10 0,12 C-5,10 -10,7 -10,2 V-6 Z"/>
            <path class="icon-mark" d="M-4,-3 L4,5 M4,-3 L-4,5"/>
        </symbol>
        <symbol id="unit-spearman" overflow="visible">
            <path d="M0,-11 L10,-6 V2 C10,7 5,10 0,12 C-5,10 -10,7 -10,2 V-6 Z"/>
            <path class="icon-mark" d="M0,7 V-6 M-3,-3 L0,-6 L3,-3"/>
        </symbol>
        <symbol id="unit-horseman" overflow="visible">
            <path d="M0,-12 L12,0 L0,12 L-12,0 Z"/>
            <path class="icon-mark" d="M-5,5 L-2,-2 L3,-5 L5,-1 L1,0 L1,5"/>
        </symbol>
        <symbol id="unit-archer" overflow="visible">
            <path d="M-11,-9 H11 V9 H-11 Z"/>
            <path class="icon-mark" d="M-2,-6 C4,-4 4,4 -2,6 M-2,-6 V6 M-5,0 H5"/>
        </symbol>
        <symbol id="terrain-plains" overflow="visible">
            <polygon points="0,-11 9.5,-5.5 9.5,5.5 0,11 -9.5,5.5 -9.5,-5.5"/>
        </symbol>
        <symbol id="terrain-forest" overflow="visible">
            <polygon points="0,-11 9.5,-5.5 9.5,5.5 0,11 -9.5,5.5 -9.5,-5.5"/>
            <path class="terrain-mark" d="M-4,-7 L-8,1 H0 Z M-4,1 V5 M4,-4 L0,4 H8 Z M4,4 V8"/>
        </symbol>
        <symbol id="terrain-hills" overflow="visible">
            <polygon points="0,-11 9.5,-5.5 9.5,5.5 0,11 -9.5,5.5 -9.5,-5.5"/>
            <path class="terrain-mark" d="M-9,4 C-7,-4 -1,-4 1,4 M-1,1 C1,-6 7,-6 9,1"/>
        </symbol>
        <symbol id="terrain-mountains" overflow="visible">
            <polygon points="0,-11 9.5,-5.5 9.5,5.5 0,11 -9.5,5.5 -9.5,-5.5"/>
            <path class="terrain-mark" d="M-9,6 L-3,-6 L1,1 L4,-3 L9,6 Z"/>
        </symbol>
        <symbol id="terrain-lake" overflow="visible">
            <polygon points="0,-11 9.5,-5.5 9.5,5.5 0,11 -9.5,5.5 -9.5,-5.5"/>
            <path class="terrain-mark" d="M-8,-3 C-5,-6 -3,0 0,-3 C3,-6 5,0 8,-3 M-8,3 C-5,0 -3,6 0,3 C3,0 5,6 8,3"/>
        </symbol>
        <symbol id="ui-movement" overflow="visible">
            <path class="icon-line" d="M-9,0 H7 M1,-6 L7,0 L1,6"/>
        </symbol>
        <symbol id="ui-sight" overflow="visible">
            <path class="icon-line" d="M-10,0 C-5,-7 5,-7 10,0 C5,7 -5,7 -10,0 Z"/>
            <circle r="3"/>
        </symbol>
        <symbol id="ui-production" overflow="visible">
            <path class="icon-line" d="M-8,8 L2,-2"/>
            <path d="M0,-10 L9,-1 L5,3 L-4,-6 Z"/>
        </symbol>
        <symbol id="ui-health" overflow="visible">
            <path d="M0,9 C-12,1 -9,-9 0,-4 C9,-9 12,1 0,9 Z"/>
        </symbol>
        <symbol id="ui-strength" overflow="visible">
            <path class="icon-line" d="M-8,8 L7,-7 M7,-7 H2 M7,-7 V-2 M-8,3 L-3,8"/>
        </symbol>
        <symbol id="ui-turns" overflow="visible">
            <path class="icon-line" d="M-6,-9 H6 L-6,9 H6 Z"/>
        </symbol>
    </defs>
</svg>
