        </symbol>
        <symbol id="building-harbour" overflow="visible">
            <circle r="11"/>
            <path class="icon-mark" d="M0,-7 V6 M-5,-3 H5 M-6,2 C-5,7 5,7 6,2"/>
        </symbol>
        <symbol id="resource-food" overflow="visible">
            <path d="M0,-11 C6,-6 6,4 0,11 C-6,4 -6,-6 0,-11 Z"/>
        </symbol>
        <symbol id="resource-wood" overflow="visible">
            <path d="M0,-11 L9,5 H-9 Z M-2,5 H2 V11 H-2 Z"/>
        </symbol>
        <symbol id="resource-stone" overflow="visible">
