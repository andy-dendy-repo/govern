        <symbol id="ui-bridge" overflow="visible">
            <path class="icon-line" d="M-10,4 C-5,-4 5,-4 10,4 M-10,-2 H10 M-5,-2 V2 M5,-2 V2"/>
        </symbol>
    </defs>
</svg>
