        </symbol>
        <symbol id="building-campus" overflow="visible">
            <path d="M0,-11 L12,-4 L0,3 L-12,-4 Z M-7,0 V6 C-3,9 3,9 7,6 V0 L0,4 Z"/>
        </symbol>
        <symbol id="building-trade_post" overflow="visible">
            <path d="M-11,-3 L0,-11 L11,-3 V10 H-11 Z"/>
            <circle class="icon-mark" cy="3" r="3"/>
        </symbol>
        <symbol id="building-culture_centre" overflow="visible">
