@using Govern.Client.Features.Home.Pages

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFoundPage)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <RadzenText TextStyle="TextStyle.Body1">You are not allowed to see this page.</RadzenText>
                }
                else
                {
                    <RedirectToLogin/>
                }
            </NotAuthorized>
            <Authorizing>
                <RadzenText TextStyle="TextStyle.Body1">Checking your session…</RadzenText>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
</Router>
