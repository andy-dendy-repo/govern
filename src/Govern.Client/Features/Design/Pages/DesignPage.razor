@page "/design"
@* The living catalog of the game's design system (docs/features/game-ui.md): every shared game component with sample data,
   the icon set and the seat and terrain colours. Development only: elsewhere it shows the not-found text. Look here before
   building a new component, and add each new one here. *@
@using Govern.Client.Features.Games.Services
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

<PageTitle>Design system - Govern</PageTitle>

@if (!Environment.IsDevelopment())
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Not found</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1" class="not-found">Sorry, the page you requested does not exist.</RadzenText>
}
else
{
    <GameSprite/>
    <RadzenStack Gap="1.5rem" class="design-page">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Design system</RadzenText>

        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Icons</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" class="design-icons">
            @foreach (var unit in Ruleset.Units)
            {
                <span class="design-swatch"><GameIcon Id="@Icons.Unit(unit.Id)" Class="seat-1"/> @Ruleset.UnitName(unit.Id)</span>
            }
            @foreach (var terrain in Ruleset.Terrains)
            {
                <span class="design-swatch"><GameIcon Id="@Icons.Terrain(terrain.Id)" Class="@($"terrain terrain-{terrain.Id}")"/> @Ruleset.TerrainName(terrain.Id)</span>
            }
            @foreach (var (id, name) in Glyphs)
            {
                <span class="design-swatch"><GameIcon Id="@id"/> @name</span>
            }
        </RadzenStack>

        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Seats</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" class="design-seats">
            @for (var seat = 1; seat <= 4; seat++)
            {
                <span class="@($"design-swatch seat-{seat}")"><span class="seat-swatch"></span> Seat @seat</span>
            }
        </RadzenStack>

        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">StatTable and NumberTooltip</RadzenText>
        <StatTable Rows="@SampleStats"/>

        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">ProgressBar and CostLabel</RadzenText>
        <ProgressBar Value="2" Max="6" PerTurn="1" Label="Production"/>
        <CostLabel Amount="4"/>

        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">ConfirmButton</RadzenText>
        <ConfirmButton Text="Disband" Icon="delete" Question="Disband this unit?" ConfirmText="Yes, disband" Class="disband"/>
    </RadzenStack>
}

@code {
    private static readonly (string Id, string Name)[] Glyphs =
        [(Icons.City, "City"), (Icons.Movement, "Movement"), (Icons.Sight, "Sight"), (Icons.Production, "Production"), (Icons.Turns, "Turns")];

    private static readonly StatRow[] SampleStats =
    [
        new(Icons.Movement, "Movement", "1 of 2", "Movement left this turn: 1. Each turn starts with 2."),
        new(Icons.Sight, "Sight", "2"),
    ];

    [Inject] private IWebAssemblyHostEnvironment Environment { get; set; } = null!;

    [Inject] private RulesetService Rulesets { get; set; } = null!;

    private Govern.Core.Rulesets.Ruleset Ruleset => Rulesets.Ruleset;
}
