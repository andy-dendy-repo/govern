@page "/design/maps"
@* The map preview (G18): each pool map (maps/<key>.json) on the board, fully in sight, with the first starting unit on every spawn
   candidate and its mirror (docs/game/maps.md). For authoring maps. Development only: elsewhere it shows the not-found text. *@
@using Govern.Client.Features.Design.Helpers
@using Govern.Client.Features.Games.Components.Board
@using Govern.Client.Features.Games.Services
@using Govern.Core.Map
@using Govern.Core.Visibility
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@if (!Environment.IsDevelopment())
{
    <PageTitle>Not found - Govern</PageTitle>
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Not found</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1" class="not-found">Sorry, the page you requested does not exist.</RadzenText>
}
else
{
    <PageTitle>Map preview - Govern</PageTitle>
    <CascadingValue Value="@_ui" IsFixed="true">
        <GameSprite/>
        <RadzenStack Gap="1rem" class="map-preview-page">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Map preview</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenDropDown TValue="string" Data="@Maps.Maps" TextProperty="@nameof(PredefinedMap.Name)" ValueProperty="@nameof(PredefinedMap.Key)"
                                Value="@_map.Key" ValueChanged="@Show" aria-label="Map" class="preview-map"/>
                <RadzenText TextStyle="TextStyle.Body2" class="preview-size">
                    @_map.Map.Width×@_map.Map.Height, @_map.Spawns.Length spawn @(_map.Spawns.Length == 1 ? "candidate" : "candidates") a side
                </RadzenText>
            </RadzenStack>
            <GameBoard View="@_view" Selection="@_ui.Selection" Highlights="@_ui.Highlights" Lens="@_ui.ActiveLens"
                       MaxHealth="@Rulesets.Ruleset.Combat.MaxHealth"/>
        </RadzenStack>
    </CascadingValue>
}

@code {
    private readonly GameUiService _ui = new();
    private PredefinedMap _map = null!;
    private PlayerView _view = null!;

    [Inject] private IWebAssemblyHostEnvironment Environment { get; set; } = null!;

    [Inject] private RulesetService Rulesets { get; set; } = null!;

    [Inject] private MapPoolService Maps { get; set; } = null!;

    protected override void OnInitialized() => Show(Maps.Maps[0].Key);

    private void Show(string key)
    {
        _map = Maps.Maps.First(map => map.Key == key);
        _view = MapPreviewBuilder.Build(Rulesets.Ruleset, _map, (_view?.Version ?? 0) + 1);
    }
}
