@page "/games"
@attribute [Authorize]
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Models
@using Govern.Core.State

<PageTitle>My games - Govern</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">My games</RadzenText>

<ApiErrorAlert Error="@_error"/>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenDropDown TValue="int" Data="@SeatChoices" Value="@_seats" ValueChanged="@SeatsChanged" Disabled="@_creating"
                    aria-label="Players" class="seat-choice">
        <Template Context="seats">@seats players</Template>
        <ValueTemplate Context="seats">@seats players</ValueTemplate>
    </RadzenDropDown>
    <RadzenDropDown TValue="string" Data="@Maps.OptionsFor(_seats)" TextProperty="@nameof(MapOption.Name)" ValueProperty="@nameof(MapOption.Value)"
                    @bind-Value="@_map" Disabled="@_creating" aria-label="Map" class="map-choice"/>
    <RadzenDropDown TValue="TurnMode" Data="@TurnModes.All" @bind-Value="@_turnMode" Disabled="@_creating"
                    aria-label="Turns" class="turn-choice">
        <Template Context="mode">@TurnModes.Describe(mode)</Template>
        <ValueTemplate Context="mode">@TurnModes.Describe(mode)</ValueTemplate>
    </RadzenDropDown>
    <RadzenButton Text="New game" Icon="add" IsBusy="@_creating" Click="@CreateAsync" class="new-game"/>
    <RadzenLink Path="join" Text="Join with a code" class="join-link"/>
</RadzenStack>

<RadzenDataGrid TItem="MyGameItem" Data="@_items" Count="@_total" LoadData="@LoadAsync" IsLoading="@_loading"
                AllowPaging="true" PageSize="@PageSize" EmptyText="No games yet. Create one, or join with a code." class="games">
    <Columns>
        <RadzenDataGridColumn TItem="MyGameItem" Title="Game">
            <Template Context="game">
                <RadzenLink Path="@($"games/{game.Id}")" Text="@PhaseText(game.Phase)" class="open-game"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="MyGameItem" Title="Players">
            <Template Context="game">@game.PlayerCount/@game.Seats</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="MyGameItem" Title="Role">
            <Template Context="game">@(game.IsCreator ? "Created" : "Joined")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="MyGameItem" Title="Turn">
            <Template Context="game">@(game.IsYourTurn ? "Your turn" : game.IsOut && game.Phase == GamePhase.InProgress ? "You're out" : string.Empty)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="MyGameItem" Title="Last activity">
            <Template Context="game">@game.ActivityAt.ToLocalTime().ToString("g", null)</Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
