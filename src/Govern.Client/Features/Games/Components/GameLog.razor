@* The game log at the bottom of the side panel: what happened in the previous round and this one, newest first and grouped
   by round, only what the player could see (the server filters it). A line with a place centres the board on it and selects
   the player's own unit or city there. The header collapses it. *@
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Models
@using Govern.Client.Features.Games.Services
@using Govern.Core.Rulesets
@using Govern.Core.Visibility

<section class="game-log" aria-label="Game log">
    <RadzenButton Text="Game log" Icon="@(Ui.LogOpen ? "expand_less" : "expand_more")" ButtonStyle="ButtonStyle.Base"
                  Variant="Variant.Text" Size="ButtonSize.Small" class="game-log-toggle" aria-expanded="@(Ui.LogOpen ? "true" : "false")"
                  Click="@(() => Ui.LogOpen = !Ui.LogOpen)"/>
    @if (Ui.LogOpen)
    {
        @if (Rounds.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="game-log-empty">Nothing has happened yet.</RadzenText>
        }
        @foreach (var (turn, lines) in Rounds)
        {
            <RadzenText TextStyle="TextStyle.Overline" TagName="TagName.H3" class="game-log-round">Turn @turn</RadzenText>
            <ul class="game-log-lines">
                @foreach (var line in lines)
                {
                    <li class="@(line.IsYours ? "game-log-line yours" : "game-log-line theirs")">
                        @if (line.Tile is { } tile)
                        {
                            <button type="button" class="game-log-show" @onclick="@(() => Ui.Show(Ruleset, View, tile))">@line.Text</button>
                        }
                        else
                        {
                            <span>@line.Text</span>
                        }
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    [CascadingParameter] public GameUiService Ui { get; set; } = null!;

    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public Ruleset Ruleset { get; set; } = null!;

    /// <summary>The player's recent log, oldest first (from the game response).</summary>
    [Parameter] public IReadOnlyList<GameLogItem>? Log { get; set; }

    // Newest round first, and the newest line first within it.
    private List<(int Turn, List<GameLogLine> Lines)> Rounds => (Log ?? [])
        .GroupBy(static item => item.Turn)
        .OrderByDescending(static round => round.Key)
        .Select(round => (round.Key, round
            .OrderByDescending(static item => item.Sequence)
            .SelectMany(item => item.Events.Reverse().Select(gameEvent => GameLogFormatter.Describe(Ruleset, View, gameEvent)))
            .OfType<GameLogLine>()
            .ToList()))
        .Where(static round => round.Item2.Count > 0)
        .ToList();
}
