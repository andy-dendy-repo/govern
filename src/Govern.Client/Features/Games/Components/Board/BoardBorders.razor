@* The borders of the territories the player sees (BoardLayer.Borders): along every edge where a city's territory ends, a line in
   its owner's seat colour, set slightly inside the owned tile so two neighbouring territories show both colours. Territory is
   shown on tiles in sight (and the player's own territory always is). Like the terrain, it renders again only for a new view. *@
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Helpers
@using Govern.Core.Visibility

@if (Borders().Any())
{
    <g class="layer-borders" data-layer="@BoardLayers.Name(BoardLayer.Borders)">
        @foreach (var (coord, neighbour, owner) in Borders())
        {
            var (x1, y1, x2, y2) = Inset(coord, neighbour);
            <line x1="@HexLayout.Format(x1)" y1="@HexLayout.Format(y1)" x2="@HexLayout.Format(x2)" y2="@HexLayout.Format(y2)"
                  class="@($"border {Seats.Class(View, owner)}")"/>
        }
    </g>
}
