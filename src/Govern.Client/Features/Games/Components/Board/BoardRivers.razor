@* The rivers the player knows of, one line along each river edge (BoardLayer.Rivers), drawn wider per kind and with a title for
   assistive technology, so a river is never told by colour alone, and the bridges over them (in sight only), a plank across
   the edge. Nothing is rendered while no river is known. Like the terrain, it renders again only for a new view. *@
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Services
@using Govern.Core.Visibility

@if (Rivers().Any())
{
    <g class="layer-rivers" data-layer="@BoardLayers.Name(BoardLayer.Rivers)">
        @foreach (var (edge, river, visibility) in Rivers())
        {
            var (x1, y1, x2, y2) = HexLayout.EdgeEnds(edge);
            <line x1="@HexLayout.Format(x1)" y1="@HexLayout.Format(y1)" x2="@HexLayout.Format(x2)" y2="@HexLayout.Format(y2)"
                  class="@($"river river-{river} {(visibility == TileVisibility.Visible ? "visible" : "explored")}")">
                <title>@RiverDescription.For(Rulesets.Ruleset, river)</title>
            </line>
        }
        @foreach (var edge in Bridges())
        {
            var (x1, y1, x2, y2) = HexLayout.BridgeEnds(edge);
            <line x1="@HexLayout.Format(x1)" y1="@HexLayout.Format(y1)" x2="@HexLayout.Format(x2)" y2="@HexLayout.Format(y2)" class="bridge">
                <title>Bridge</title>
            </line>
        }
    </g>
}
