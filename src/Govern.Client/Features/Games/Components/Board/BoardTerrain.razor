@* The map's tiles, one clickable hex each, and the terrain's symbol on every known tile that isn't the default terrain, so
   terrain is never told by colour alone. It renders again only for a new view, so panning and zooming never re-diff them. *@
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Services
@using Govern.Core.Map
@using Govern.Core.Visibility

<g class="layer-terrain" data-layer="@BoardLayers.Name(BoardLayer.Terrain)">
    @for (var index = 0; index < View.Tiles.Length; index++)
    {
        var coord = View.CoordAt(index);
        var (x, y) = HexLayout.Center(coord);
        <use href="#hex" x="@HexLayout.Format(x)" y="@HexLayout.Format(y)" class="@TileClass(View.Tiles[index])"
             data-q="@coord.Q" data-r="@coord.R" @onclick="@(() => TileClicked.InvokeAsync(coord))"/>
    }
    @for (var index = 0; index < View.Tiles.Length; index++)
    {
        if (View.Tiles[index] is not { Terrain: { } terrain } tile || terrain == Rulesets.Ruleset.Map.DefaultTerrain)
        {
            continue;
        }

        var (x, y) = HexLayout.Center(View.CoordAt(index));
        <use href="@($"#{Icons.Terrain(terrain)}")" transform="translate(@HexLayout.Format(x) @HexLayout.Format(y)) scale(@SymbolScale)"
             class="@($"terrain-symbol terrain-{terrain} {(tile.Visibility == TileVisibility.Visible ? "visible" : "explored")}")"/>
    }
</g>

@code {
    private PlayerView? _rendered;

    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter] public EventCallback<HexCoord> TileClicked { get; set; }

    // Terrain symbols are drawn for a 26×26 box; on the board they fill about half a tile.
    private const string SymbolScale = "1.6";

    [Inject] private RulesetService Rulesets { get; set; } = null!;

    protected override bool ShouldRender() => !ReferenceEquals(View, _rendered);

    protected override void OnAfterRender(bool firstRender) => _rendered = View;

    private static string TileClass(TileView tile) => tile.Visibility switch
    {
        TileVisibility.Visible => $"tile visible terrain-{tile.Terrain}",
        TileVisibility.Explored => $"tile explored terrain-{tile.Terrain}",
        _ => "tile unexplored",
    };
}
