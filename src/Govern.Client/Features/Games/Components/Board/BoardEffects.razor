@* The animation's effects over everything (BoardAnimationService): damage numbers that float up and a pulse on a tile where
   something was founded, captured or built. Their CSS animations (board.css) play once per effect, keyed so a new one restarts. *@
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Models

<g class="layer-effects" data-layer="@BoardLayers.Name(BoardLayer.Effects)">
    @foreach (var effect in Motion.Effects)
    {
        @if (effect.Kind == BoardEffectKind.Damage)
        {
            <g @key="effect.Key" class="effect damage" transform="translate(@HexLayout.Format(effect.At.X) @HexLayout.Format(effect.At.Y - 14))">
                <text>@effect.Text</text>
            </g>
        }
        else
        {
            <use @key="effect.Key" href="#hex" class="effect pulse" x="@HexLayout.Format(effect.At.X)" y="@HexLayout.Format(effect.At.Y)"/>
        }
    }
</g>

@code {
    private BoardMotion? _rendered;

    /// <summary>The effects to draw.</summary>
    [Parameter] public BoardMotion Motion { get; set; } = BoardMotion.None;

    protected override bool ShouldRender() => !ReferenceEquals(_rendered, Motion);

    protected override void OnAfterRender(bool firstRender) => _rendered = Motion;
}
