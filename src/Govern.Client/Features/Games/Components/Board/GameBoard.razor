@* The hex board: terrain, rivers and bridges, improvements, the active map lens, cities, units and the selected unit's moves, attacks and bridge sites, and the animation's effects on top. It opens on the player's own units and cities; Fit shows the whole map. Drag to pan; the wheel or the buttons zoom.
   Unit and city symbols come from the game's icon set (Components/Game/GameSprite), rendered once by the game screen. *@
@using Govern.Client.Features.Games.Helpers

<div class="board-frame">
    <svg @ref="_board" class="@(Disabled ? "board busy" : "board")" role="application" aria-label="Game board"
         @onpointerdown="@OnPointerDown" @onpointermove="@OnPointerMove" @onpointerup="@OnPointerUp"
         @onpointerleave="@OnPointerUp" @onwheel="@OnWheelAsync">
        <defs>
            <symbol id="hex" overflow="visible"><polygon points="@HexLayout.Corners"/></symbol>
        </defs>
        <g class="layer" transform="@_viewport.Transform">
            <BoardTerrain View="@View" TileClicked="@OnTileClickedAsync"/>
            <BoardRivers View="@View"/>
            <BoardImprovements View="@View"/>
            <BoardBorders View="@View"/>
            <BoardLens View="@View" Lens="@Lens"/>
            <BoardPieces View="@View" Selection="@Selection" Highlights="@Highlights" MaxHealth="@MaxHealth" Motion="@Motion"/>
            <BoardEffects Motion="@Motion"/>
        </g>
    </svg>
    @if (AnchorAt is { } anchorAt && Anchored is not null)
    {
        <div class="board-anchor" style="@AnchorStyle(anchorAt)">@Anchored</div>
    }
    <LensToolbar/>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" class="board-zoom">
        <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" aria-label="Zoom in"
                      Click="@(() => ZoomAtCentre(ZoomStep))" class="zoom-in"/>
        <RadzenButton Icon="remove" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" aria-label="Zoom out"
                      Click="@(() => ZoomAtCentre(1 / ZoomStep))" class="zoom-out"/>
        <RadzenButton Icon="fit_screen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" aria-label="Fit the map"
                      Click="@FitMapAsync" class="zoom-fit"/>
        <BoardModeToggle/>
    </RadzenStack>
</div>
