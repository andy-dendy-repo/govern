@* The improvements and buildings the player knows of (BoardLayer.Improvements): each one's symbol in the upper left of its
   tile, small, so the unit or city in the middle stays readable, with a title for assistive technology. A building is drawn
   in its owner's seat colour. A tile holds an improvement or a building, never both. The view carries them only for tiles in sight; the player's own city also shows, faded,
   the building it produces on the tile reserved for it. Like the terrain, it renders again only for a new view. *@
@using Govern.Client.Features.Games.Enums
@using Govern.Client.Features.Games.Helpers
@using Govern.Core.Map

@if (Improvements().Any() || Buildings().Any())
{
    <g class="layer-improvements" data-layer="@BoardLayers.Name(BoardLayer.Improvements)">
        @foreach (var (coord, improvement) in Improvements())
        {
            <use href="@($"#{Icons.Improvement(improvement)}")" transform="@Corner(coord)" class="@($"improvement improvement-{improvement}")">
                <title>@Rulesets.Ruleset.ImprovementName(improvement)</title>
            </use>
        }
        @foreach (var (coord, building, seat, planned) in Buildings())
        {
            <use href="@($"#{Icons.Building(building)}")" transform="@Corner(coord)"
                 class="@($"tile-building tile-building-{building} {seat}{(planned ? " planned" : "")}")">
                <title>@(planned ? $"{Rulesets.Ruleset.BuildingName(building)} (being built)" : Rulesets.Ruleset.BuildingName(building))</title>
            </use>
        }
    </g>
}
