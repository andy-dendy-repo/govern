@* The highlights, cities and units over the terrain, each in its BoardLayer. Clicks pass through to the tiles
   (pointer-events: none in board.css). Pieces are coloured by seat (seat-1, seat-2: turn order) and marked own or enemy.
   A hurt unit shows its health as a bar under its symbol; a pending attack target is marked. A unit is placed with a CSS
   transform, so a position from the animation's Motion (BoardAnimationService) slides; ghosts are units the view no longer has. *@
@using Govern.Client.Features.Games.Helpers
@using Govern.Client.Features.Games.Models
@using Govern.Client.Features.Games.Enums
@using Govern.Core.Map
@using Govern.Core.State
@using Govern.Core.Visibility

<g class="layer-highlights" data-layer="@BoardLayers.Name(BoardLayer.Highlights)">
    @foreach (var coord in Highlights.Reachable)
    {
        <use href="#hex" x="@X(coord)" y="@Y(coord)" class="overlay reachable"/>
    }
    @foreach (var coord in Highlights.Attackable)
    {
        <use href="#hex" x="@X(coord)" y="@Y(coord)" class="@(coord == Selection.Target ? "overlay attackable target" : "overlay attackable")"/>
    }
    @foreach (var coord in Highlights.Bridgeable)
    {
        <use href="#hex" x="@X(coord)" y="@Y(coord)" class="overlay bridgeable"/>
    }
</g>
<g class="layer-cities" data-layer="@BoardLayers.Name(BoardLayer.Cities)">
    @foreach (var city in View.Cities)
    {
        <g class="@PieceClass("city", city.Owner, Selection.City == city.Id)" transform="translate(@X(city.Position) @Y(city.Position))">
            <use href="@($"#{Icons.City}")"/>
            <text y="26" class="city-name">@city.Name</text>
        </g>
    }
</g>
<g class="layer-units" data-layer="@BoardLayers.Name(BoardLayer.Units)">
    @foreach (var unit in View.Units)
    {
        <g @key="unit.Id" class="unit-at" style="@At(Motion.Positions.TryGetValue(unit.Id, out var moving) ? moving : Point(unit.Position))">
            <use href="@($"#{Icons.Unit(unit.Type)}")" class="@PieceClass($"unit {unit.Type.Id}", unit.Owner, Selection.Unit == unit.Id)"/>
            @if (MaxHealth > 0 && unit.Health < MaxHealth)
            {
                <g class="health">
                    <rect class="health-track" x="-12" y="13" width="24" height="4"/>
                    <rect class="@(unit.Health * 3 <= MaxHealth ? "health-fill low" : "health-fill")" x="-12" y="13"
                          width="@HexLayout.Format(24.0 * Math.Max(unit.Health, 0) / MaxHealth)" height="4"/>
                </g>
            }
        </g>
    }
    @foreach (var ghost in Motion.Ghosts)
    {
        <g @key="ghost.Key" class="@(ghost.Fading ? "unit-at ghost fading" : "unit-at ghost")" style="@At(ghost.At)">
            <use href="@($"#{Icons.Unit(ghost.Type)}")" class="@PieceClass($"ghost-unit {ghost.Type.Id}", ghost.Owner, selected: false)"/>
        </g>
    }
</g>

@code {
    private (PlayerView View, BoardSelection Selection, BoardHighlights Highlights, BoardMotion Motion)? _rendered;

    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public BoardSelection Selection { get; set; } = null!;

    [Parameter, EditorRequired] public BoardHighlights Highlights { get; set; } = null!;

    /// <summary>Where the playing animation draws units and ghosts instead of their tiles.</summary>
    [Parameter] public BoardMotion Motion { get; set; } = BoardMotion.None;

    /// <summary>The ruleset's full health; hurt units get a health bar. 0 draws none.</summary>
    [Parameter] public int MaxHealth { get; set; }

    protected override bool ShouldRender() =>
        _rendered is not { } rendered
        || !ReferenceEquals(rendered.View, View) || rendered.Selection != Selection || !ReferenceEquals(rendered.Highlights, Highlights)
        || !ReferenceEquals(rendered.Motion, Motion);

    protected override void OnAfterRender(bool firstRender) => _rendered = (View, Selection, Highlights, Motion);

    private static string X(HexCoord coord) => HexLayout.Format(HexLayout.Center(coord).X);

    private static string Y(HexCoord coord) => HexLayout.Format(HexLayout.Center(coord).Y);

    private static BoardPoint Point(HexCoord coord)
    {
        var (x, y) = HexLayout.Center(coord);
        return new BoardPoint(x, y);
    }

    private static string At(BoardPoint point) => $"transform: translate({HexLayout.Format(point.X)}px, {HexLayout.Format(point.Y)}px)";

    private string PieceClass(string kind, PlayerId owner, bool selected) =>
        $"piece {kind} {Seats.Class(View, owner)} {(owner == View.Viewer ? "own" : "enemy")}{(selected ? " selected" : null)}";
}
