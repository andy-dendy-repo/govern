@* One CostLabel per resource of a cost or an upkeep, with the resource's icon and name. *@
@using Govern.Core.Economy
@using Govern.Core.Rulesets

@foreach (var amount in Amounts)
{
    <CostLabel Amount="@amount.Amount" Icon="@Icons.Resource(amount.Resource)" Label="@Ruleset.ResourceName(amount.Resource)"/>
}

@code {
    [Parameter, EditorRequired] public Ruleset Ruleset { get; set; } = null!;

    [Parameter, EditorRequired] public IEnumerable<ResourceAmount> Amounts { get; set; } = [];
}
