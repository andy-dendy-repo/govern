@* Whose turn it is, End turn, and Resign (which asks first). *@
@using Govern.Core.Actions
@using Govern.Core.Engine
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="turn-panel">
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="turn">
        Turn @View.Turn: @(IsYourTurn ? "your turn" : "opponent's turn")
    </RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        @if (_confirming)
        {
            <RadzenText TextStyle="TextStyle.Body1" class="confirm-text">Resign the game? Your opponent wins.</RadzenText>
            <RadzenButton Text="Yes, resign" ButtonStyle="ButtonStyle.Danger" Disabled="@Busy"
                          Click="@(() => SendAsync(new ResignCommand()))" class="confirm-resign"/>
            <RadzenButton Text="Keep playing" ButtonStyle="ButtonStyle.Light" Click="@(() => _confirming = false)" class="dismiss"/>
        }
        else
        {
            <RadzenButton Text="End turn" Icon="skip_next" Disabled="@(Busy || !IsYourTurn)"
                          Click="@(() => SendAsync(new EndTurnCommand()))" class="end-turn"/>
            <RadzenButton Text="Resign" Icon="flag" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Disabled="@Busy"
                          Click="@(() => _confirming = true)" class="resign"/>
        }
    </RadzenStack>
</RadzenStack>

@code {
    private bool _confirming;

    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<GameCommand> Command { get; set; }

    private bool IsYourTurn => View.CurrentPlayer == View.Viewer;

    private async Task SendAsync(GameCommand command)
    {
        _confirming = false;
        await Command.InvokeAsync(command);
    }
}
