@* The players of a game of three or more (or of any simultaneous game) in turn order, in the top strip: each seat's colour,
   "You" or its seat number, and whose turn it is (in a simultaneous game, who has ended the round) or how a player left
   (resigned, eliminated). *@
@using Govern.Core.State
@using Govern.Core.Visibility

<ul class="player-strip" aria-label="Players">
    @foreach (var player in View.Players)
    {
        <li class="@($"player-strip-item {(IsToMove(player) ? "current" : string.Empty)}")">
            <span class="@($"seat-swatch {Seats.Class(View, player.Id)}")" aria-hidden="true"></span>
            <span>@Describe(player)</span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    private string Describe(PlayerSummary player)
    {
        var name = player.Id == View.Viewer ? "You" : $"Seat {Seats.Number(View, player.Id)}";
        return player.Status switch
        {
            PlayerStatus.Resigned => $"{name} (resigned)",
            PlayerStatus.Eliminated => $"{name} (eliminated)",
            _ when View.Status == GameStatus.InProgress && View.TurnMode == TurnMode.Simultaneous && player.EndedTurn => $"{name} (ended)",
            _ when IsToMove(player) && View.TurnMode == TurnMode.Sequential => $"{name} (to move)",
            _ => name,
        };
    }

    // Sequential: the player whose turn it is. Simultaneous: every player still playing the round.
    private bool IsToMove(PlayerSummary player) => View.Status == GameStatus.InProgress && (View.TurnMode == TurnMode.Simultaneous
        ? player is { Status: PlayerStatus.Active, EndedTurn: false }
        : player.Id == View.CurrentPlayer);
}
