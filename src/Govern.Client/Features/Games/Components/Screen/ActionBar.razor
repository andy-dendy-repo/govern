@* The selected own unit's actions, under its panel in the selection card (SelectionCard): what it can do. Each action is a button (keyboard-reachable), disabled
   with the reason when the rules forbid it. A new ability adds its button here. Moves and attacks are board clicks; Go to
   turns on destination mode, where a click on any explored tile sends the unit walking there on its own, and Explore sends it to
   unexplored land turn after turn (Stop cancels either order); a unit with a job can't move, so a misclick never stops a build:
   Cancel job is the way to free it; Build bridge turns on bridge mode, where a click on a marked neighbour starts the bridge; a trader gets its route
   orders (TraderOrders) and, while on a route, takes no other order. A unit with a newer unlocked version gets Upgrade to
   (paid by the city owning its tile), and a builder on a building with an unlocked upgrade gets Upgrade the building (a job). *@
@using Govern.Core.Economy
@using Govern.Client.Features.Games.Services
@using Govern.Core.Actions
@using Govern.Core.Engine
@using Govern.Core.Rulesets
@using Govern.Core.Science
@using Govern.Core.State
@using Govern.Core.Units
@using Govern.Core.Visibility

@if (Unit is { } unit)
{
    var definition = Ruleset.Unit(unit.Type);
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="action-bar">
        <GameIcon Id="@Icons.Unit(unit.Type)" Class="@Seats.Class(View, unit.Owner)"/>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="action-hint rz-m-0">@Hint(unit, definition)</RadzenText>
        @if (unit.Job is not null)
        {
            <RadzenButton Disabled="@(Busy || !MyTurn)" ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Cancel job"
                          Click="@(() => Command.InvokeAsync(new CancelJobCommand(unit.Id)))" class="cancel-job"/>
        }
        else if (unit.RouteId is null)
        {
            <RadzenButton Disabled="@(Busy || !MyTurn)" ButtonStyle="@(Ui.Selection.Destination ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                          Click="@(() => Ui.ToggleDestination(Ruleset, View))" aria-pressed="@(Ui.Selection.Destination ? "true" : "false")"
                          Icon="near_me" Text="@(Ui.Selection.Destination ? "Cancel go to" : "Go to")" class="go-to"/>
            @if (!unit.Exploring)
            {
                var exploreProblem = GameEngine.CheckExplore(Ruleset, View, unit.Id);
                <RadzenButton Disabled="@(Busy || exploreProblem is not null)" ButtonStyle="ButtonStyle.Secondary" Icon="travel_explore" Text="Explore"
                              Click="@(() => Command.InvokeAsync(new ExploreCommand(unit.Id)))" title="@exploreProblem?.Message" class="explore"/>
            }
        }
        @if ((unit.Destination is not null || unit.Exploring) && unit.RouteId is null)
        {
            <RadzenButton Disabled="@(Busy || !MyTurn)" ButtonStyle="ButtonStyle.Secondary" Icon="block" Text="Stop"
                          Click="@(() => Command.InvokeAsync(new SetDestinationCommand(unit.Id, null)))" class="stop-order"/>
        }
        @if (ScienceCalculator.UnitUpgrade(Ruleset, Nodes, unit.Type) is { } upgrade && unit.RouteId is null)
        {
            var problem = SciencePreviewCalculator.CheckUpgradeUnit(Ruleset, View, unit.Id);
            <RadzenButton Disabled="@(Busy || problem is not null)" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Command.InvokeAsync(new UpgradeUnitCommand(unit.Id)))" class="upgrade-unit">
                <GameIcon Id="@Icons.Unit(upgrade.Id)"/>
                <span>Upgrade to @Ruleset.UnitName(upgrade.Id)</span>
                <ResourceCostLabels Ruleset="@Ruleset" Amounts="@(upgrade.UpgradeCost ?? [])"/>
            </RadzenButton>
            @if (problem is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="upgrade-unit-reason">@problem.Message</RadzenText>
            }
        }
        @if (definition.CanFoundCity)
        {
            <FoundCityPrompt @key="unit.Id" View="@View" Ruleset="@Ruleset" UnitId="@unit.Id" Busy="@Busy" Command="@Command"/>
        }
        @if (definition.CanBuildImprovements)
        {
            var fitting = Fitting(unit).ToList();
            @foreach (var improvement in fitting)
            {
                var problem = GameEngine.CheckBuildImprovement(Ruleset, View, unit.Id, improvement.Id);
                <RadzenButton Disabled="@(Busy || problem is not null)" ButtonStyle="ButtonStyle.Secondary"
                              Click="@(() => Command.InvokeAsync(new BuildImprovementCommand(unit.Id, improvement.Id)))"
                              class="@($"build-improvement build-{improvement.Id.Id}")">
                    <GameIcon Id="@Icons.Improvement(improvement.Id)"/>
                    <span>Build @Ruleset.ImprovementName(improvement.Id)</span>
                    <CostLabel Amount="@improvement.Cost"/>
                </RadzenButton>
                @if (problem is not null)
                {
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="build-improvement-reason">@problem.Message</RadzenText>
                }
            }
            @if (fitting.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="no-improvement">No improvement fits this terrain.</RadzenText>
            }
        }
        @if (definition.CanBuildImprovements && BuildingHere(unit) is { } building
             && ScienceCalculator.BuildingUpgrade(Ruleset, Nodes, building) is { } next && unit.Job?.UpgradeTo is null)
        {
            var problem = SciencePreviewCalculator.CheckUpgradeBuilding(Ruleset, View, unit.Id);
            <RadzenButton Disabled="@(Busy || problem is not null)" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Command.InvokeAsync(new UpgradeBuildingCommand(unit.Id)))" class="upgrade-building">
                <GameIcon Id="@Icons.Building(next.Id)"/>
                <span>Upgrade the @Ruleset.BuildingName(building) to a @Ruleset.BuildingName(next.Id)</span>
                <CostLabel Amount="@next.Cost"/>
                <ResourceCostLabels Ruleset="@Ruleset" Amounts="@next.ResourceCost"/>
            </RadzenButton>
            @if (problem is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="upgrade-building-reason">@problem.Message</RadzenText>
            }
        }
        @if (definition.CanTrade)
        {
            <TraderOrders @key="unit.Id" View="@View" Ruleset="@Ruleset" Unit="@unit" Busy="@Busy" Command="@Command"/>
        }
        @if (definition.CanBuildBridges)
        {
            var targets = GameEngine.BridgeTargets(Ruleset, View, unit.Id);
            <RadzenButton Disabled="@(Busy || targets.IsEmpty)" ButtonStyle="@(Ui.Selection.Bridge ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                          Click="@(() => Ui.ToggleBridge(Ruleset, View))" aria-pressed="@(Ui.Selection.Bridge ? "true" : "false")" class="build-bridge">
                <GameIcon Id="@Icons.Bridge"/>
                <span>@(Ui.Selection.Bridge ? "Cancel bridge" : "Build bridge")</span>
                <CostLabel Amount="@Ruleset.Bridges.Cost"/>
            </RadzenButton>
            @if (targets.IsEmpty)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="build-bridge-reason">No river next to this unit can be bridged now.</RadzenText>
            }
        }
    </RadzenStack>
}

@code {
    [CascadingParameter] public GameUiService Ui { get; set; } = null!;

    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public Ruleset Ruleset { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<GameCommand> Command { get; set; }

    private bool MyTurn => View.CurrentPlayer == View.Viewer;

    private UnitView? Unit => View.Status == GameStatus.InProgress && Ui.Selection.Unit is { } id ? View.FindOwnUnit(id) : null;

    private string Hint(UnitView unit, UnitDefinition definition) => (Ui.Selection.Bridge, unit.Job) switch
    {
        _ when unit.RouteId is not null => "The trader walks its route on its own between the two trade posts.",
        _ when Ui.Selection.Destination => "Click any tile you have explored to send the unit there; it walks on at the start of each turn. Esc cancels.",
        (true, _) => "Click a marked tile across the river to build a bridge to it. Esc cancels.",
        (_, { Improvement: { } improvement }) => $"Building a {Ruleset.ImprovementName(improvement)}. Cancel the job to move the unit.",
        (_, { UpgradeTo: { } upgrade }) => $"Upgrading the building here to a {Ruleset.BuildingName(upgrade)}. Cancel the job to move the unit.",
        (_, { BridgeTo: not null }) => "Building a bridge. Cancel the job to move the unit.",
        _ when unit.Exploring => "The unit explores on its own at the start of each turn. Stop ends it.",
        _ when definition.AttackRange > 0 => "Click a highlighted tile to move, or an enemy to see the attack forecast.",
        _ => "Click a highlighted tile to move.",
    };

    private IEnumerable<OwnedNode> Nodes => View.Science?.NodeList ?? [];

    // The building on the unit's tile, if the player can see one there (always, on their own territory).
    private BuildingType? BuildingHere(UnitView unit) => View.TileAt(unit.Position).Building;

    // The improvements that can go on the unit's terrain; their other checks show as the button's reason.
    private IEnumerable<ImprovementDefinition> Fitting(UnitView unit) =>
        View.TileAt(unit.Position).Terrain is { } terrain
            ? Ruleset.Improvements.Where(improvement => improvement.Terrains.Contains(terrain))
            : [];
}
