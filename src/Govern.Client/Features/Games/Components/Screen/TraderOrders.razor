@* The trader's line in the action bar (G17b). Deals are made in the trader's home city's Market tab, so this says which city
   that is and how its deal stands, and Make a deal opens that tab. A trader with no home city (its owner lost every city)
   says so. *@

@if (Home is { } home)
{
    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="trader-deal rz-m-0">@Status(home)</RadzenText>
    <RadzenButton Disabled="@Busy" ButtonStyle="ButtonStyle.Secondary" Icon="storefront" Text="@(Deal is null ? "Make a deal" : "Open market")"
                  Click="@(() => Ui.OpenMarket(Ruleset, View, home.Id))" class="trader-open-market"/>
}
else
{
    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="trader-deal rz-m-0">This trader has no home city to trade from.</RadzenText>
}
