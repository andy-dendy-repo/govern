@* A started game: the full-screen game view (see docs/features/game-ui.md). The board fills the screen, and the controls float
   over it: the top strip, notices, the selection card in the bottom-left corner, the attack forecast beside its target and the
   log drawer, and the science tree as a large view. Sends one command at a time. Esc closes the science tree or the log drawer,
   else clears the selection. *@
@using Govern.Client.Features.Games.Components.Board
@using Govern.Client.Features.Games.Components.Screen

<CascadingValue Value="@_ui" IsFixed="true">
    <GameSprite/>
    <div @ref="_screen" class="game-screen" tabindex="-1" @onkeydown="@OnKeyDown">
        <div class="hud-board">
            <GameBoard View="@View" Selection="@_ui.Selection" Highlights="@_ui.Highlights" Lens="@_ui.ActiveLens" MaxHealth="@Ruleset.Combat.MaxHealth" Focus="@_ui.Focus" Motion="@_animation.Motion" Disabled="@_sending" TileClicked="@OnTileClickedAsync"
                       Anchored="@ForecastCard" AnchorAt="@ForecastAt"/>
        </div>
        <div @ref="_strip" class="hud hud-top">
            <TopBar View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync" Title="@Title" Connection="@Connection" Log="@Game.Log"
                    FullScreenSupported="@_fullScreenSupported" FullScreenToggled="@ToggleFullScreenAsync"/>
        </div>
        <div class="hud hud-notices">
            <NoticeStack View="@View" Stale="@_stale" Error="@_error"/>
        </div>
        <div class="@(_ui.Selection.City is not null ? "hud hud-selection hud-selection-city" : "hud hud-selection")">
            <SelectionCard View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync"/>
        </div>
        @if (_ui.ScienceOpen)
        {
            <div class="hud hud-large">
                <ScienceTree View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync"/>
            </div>
        }
        @if (_ui.LogOpen)
        {
            <div class="hud hud-log">
                <LogDrawer View="@View" Ruleset="@Ruleset" Log="@Game.Log"/>
            </div>
        }
    </div>
</CascadingValue>

@code {
    // The forecast of a pending attack, kept beside its target on the board.
    private RenderFragment ForecastCard => @<AttackForecast View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync"/>;
}
