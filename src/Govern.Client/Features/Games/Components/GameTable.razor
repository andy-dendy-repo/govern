@* A started game: the game screen with its zones (top bar, map, side panel, action bar; see docs/features/game-ui.md).
   Sends one command at a time. Esc clears the selection. *@
@using Govern.Client.Features.Games.Components.Board
@using Govern.Client.Features.Games.Components.Screen

<CascadingValue Value="@_ui" IsFixed="true">
    <GameSprite/>
    <div @ref="_screen" class="game-screen" tabindex="-1" @onkeydown="@OnKeyDown">
        <div class="zone-top">
            <TopBar View="@View" Busy="@_sending" Command="@SendAsync"/>
        </div>
        <div class="zone-map">
            <GameBoard View="@View" Selection="@_ui.Selection" Highlights="@_ui.Highlights" Lens="@_ui.ActiveLens" Disabled="@_sending" TileClicked="@OnTileClickedAsync"/>
        </div>
        <div class="zone-actions">
            <ActionBar View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync"/>
        </div>
        <aside class="zone-side">
            <SidePanel View="@View" Ruleset="@Ruleset" Busy="@_sending" Command="@SendAsync">
                @if (_stale)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="stale">
                        The game changed before your move arrived, so nothing was applied. The board is up to date now.
                    </RadzenAlert>
                }
                <ApiErrorAlert Error="@_error"/>
            </SidePanel>
        </aside>
    </div>
</CascadingValue>
