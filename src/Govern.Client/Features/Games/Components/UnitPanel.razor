@* The selected unit: its type and movement and, for the player's settler, Found city (disabled with the reason). *@
@using Govern.Core.Actions
@using Govern.Core.Engine
@using Govern.Core.Units
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="unit-panel">
    <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" class="unit-name">
        @(IsOwn ? "Your" : "Enemy") @(Unit.Type == UnitType.Settler ? "settler" : "soldier")
    </RadzenText>
    @if (IsOwn)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="movement">
            Movement left: @Unit.MovementLeft of @Unit.Definition.Movement
        </RadzenText>
        @if (Unit.Definition.CanFoundCity)
        {
            var problem = GameEngine.CheckFoundCity(View, Unit.Id);
            <RadzenButton Text="Found city" Icon="location_city" Disabled="@(Busy || problem is not null)"
                          Click="@(() => Command.InvokeAsync(new FoundCityCommand(Unit.Id)))" class="found-city"/>
            @if (problem is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="found-city-reason">@problem.Message</RadzenText>
            }
        }
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public Unit Unit { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<GameCommand> Command { get; set; }

    private bool IsOwn => Unit.Owner == View.Viewer;
}
