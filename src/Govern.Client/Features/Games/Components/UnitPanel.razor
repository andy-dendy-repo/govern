@* The selected unit: its type in its owner's colour, its health and combat stats (for any unit the player sees) and, for the
   player's own unit, its movement left, sight with the bonus of the terrain it stands on, and cost.
   Its actions are in the action bar (Screen/ActionBar). *@
@using Govern.Core.Rulesets
@using Govern.Core.Units
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="unit-panel">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <GameIcon Id="@Icons.Unit(Unit.Type)" Class="@Seats.Class(View, Unit.Owner)"/>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" class="unit-name rz-m-0">
            @(IsOwn ? "Your" : "Enemy") @Ruleset.UnitName(Unit.Type)
        </RadzenText>
    </RadzenStack>
    <HealthBar Health="@Unit.Health" Max="@Ruleset.Combat.MaxHealth"/>
    <StatTable Rows="@Rows"/>
</RadzenStack>
