@* The selected unit: its type in its owner's colour and, for the player's own unit, its stats (movement left, sight, cost).
   Its actions are in the action bar (Screen/ActionBar). *@
@using Govern.Core.Rulesets
@using Govern.Core.Units
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="unit-panel">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <GameIcon Id="@Icons.Unit(Unit.Type)" Class="@Seats.Class(View, Unit.Owner)"/>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" class="unit-name rz-m-0">
            @(IsOwn ? "Your" : "Enemy") @Ruleset.UnitName(Unit.Type)
        </RadzenText>
    </RadzenStack>
    @if (IsOwn)
    {
        <StatTable Rows="@Rows"/>
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public UnitView Unit { get; set; } = null!;

    [Parameter, EditorRequired] public Ruleset Ruleset { get; set; } = null!;

    private bool IsOwn => Unit.Owner == View.Viewer;

    private StatRow[] Rows
    {
        get
        {
            var definition = Ruleset.Unit(Unit.Type);
            return
            [
                new(Icons.Movement, "Movement", $"{Unit.MovementLeft} of {definition.Movement}",
                    $"Movement left this turn: {Unit.MovementLeft}. Each turn starts with {definition.Movement}.", "movement"),
                new(Icons.Sight, "Sight", $"{definition.Sight}", $"Sees {definition.Sight} tiles around it.", "sight"),
                new(Icons.Production, "Cost", $"{definition.ProductionCost}", $"A city needs {definition.ProductionCost} production to build one.", "cost"),
            ];
        }
    }
}
