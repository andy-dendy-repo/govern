@* The selected city: its name in its owner's colour and, for the player's own city, what it produces, how long that takes,
   the buttons to change it (units and buildings, each with its cost; a building the city can't have says why), and the
   buildings it has. *@
@using Govern.Core.Cities
@using Govern.Core.Actions
@using Govern.Core.Economy
@using Govern.Core.Engine
@using Govern.Core.Rulesets
@using Govern.Core.State
@using Govern.Core.Units
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="city-panel">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <GameIcon Id="@Icons.City" Class="@Seats.Class(View, City.Owner)"/>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" class="city-name rz-m-0">@City.Name</RadzenText>
    </RadzenStack>
    @if (City.Owner != View.Viewer)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="enemy-city">Enemy city</RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" class="production">@ProductionText</RadzenText>
        @if (ProducingCost is { } cost)
        {
            <ProgressBar Value="@(City.ProductionProgress ?? 0)" Max="@cost" PerTurn="@PerTurn" Label="Production"/>
        }
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            @foreach (var unit in Ruleset.Units)
            {
                <RadzenButton Size="ButtonSize.Small"
                              ButtonStyle="@(ProducingUnit(unit.Id) ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Disabled="@(Busy || !CanAct || ProducingUnit(unit.Id))"
                              Click="@(() => Command.InvokeAsync(new SetProductionCommand(City.Id, unit.Id)))"
                              class="@($"produce produce-{unit.Id.Id}")">
                    <span class="produce-name">Build @Ruleset.UnitName(unit.Id)</span>
                    <CostLabel Amount="@unit.ProductionCost"/>
                </RadzenButton>
            }
        </RadzenStack>
        @if (Ruleset.Buildings.Length > 0)
        {
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H4" class="rz-m-0">Buildings</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="buildings">
                @foreach (var building in City.BuildingList)
                {
                    <span class="@($"building building-{building.Id}")">
                        <GameIcon Id="@Icons.Building(building)" Label="@Ruleset.BuildingName(building)"/>
                        @Ruleset.BuildingName(building)
                    </span>
                }
                @if (City.BuildingList.IsEmpty)
                {
                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="no-buildings rz-m-0">None yet</RadzenText>
                }
            </RadzenStack>
            <RadzenStack Gap="0.25rem">
                @foreach (var building in Ruleset.Buildings.Where(building => !City.BuildingList.Contains(building.Id)))
                {
                    var problem = GameEngine.CheckProduceBuilding(Ruleset, View, City.Id, building.Id);
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenButton Size="ButtonSize.Small"
                                      ButtonStyle="@(City.ProducingBuilding == building.Id ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Disabled="@(Busy || !CanAct || problem is not null || City.ProducingBuilding == building.Id)"
                                      Click="@(() => Command.InvokeAsync(new ProduceBuildingCommand(City.Id, building.Id)))"
                                      class="@($"produce produce-building-{building.Id.Id}")">
                            <GameIcon Id="@Icons.Building(building.Id)"/>
                            <span class="produce-name">Build @Ruleset.BuildingName(building.Id)</span>
                            <CostLabel Amount="@building.Cost"/>
                        </RadzenButton>
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="building-effect">@Effect(building)</RadzenText>
                        @if (problem is not null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="building-reason">@problem.Message</RadzenText>
                        }
                    </RadzenStack>
                }
            </RadzenStack>
        }
    }
</RadzenStack>
