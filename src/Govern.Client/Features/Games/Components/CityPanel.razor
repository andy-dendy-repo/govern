@* The selected city: its name in its owner's colour and, for the player's own city, what it produces, how long that takes,
   and the buttons to change it (each with its cost). *@
@using Govern.Core.Actions
@using Govern.Core.Engine
@using Govern.Core.Rulesets
@using Govern.Core.State
@using Govern.Core.Units
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="city-panel">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <GameIcon Id="@Icons.City" Class="@Seats.Class(View, City.Owner)"/>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" class="city-name rz-m-0">@City.Name</RadzenText>
    </RadzenStack>
    @if (City.Owner != View.Viewer)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="enemy-city">Enemy city</RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" class="production">@ProductionText</RadzenText>
        @if (City.Producing is { } producing)
        {
            <ProgressBar Value="@(City.ProductionProgress ?? 0)" Max="@Ruleset.Unit(producing).ProductionCost"
                         PerTurn="@Ruleset.Cities.ProductionPerTurn" Label="Production"/>
        }
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            @foreach (var unit in Ruleset.Units)
            {
                <RadzenButton Size="ButtonSize.Small"
                              ButtonStyle="@(City.Producing == unit.Id ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Disabled="@(Busy || !CanAct || City.Producing == unit.Id)"
                              Click="@(() => Command.InvokeAsync(new SetProductionCommand(City.Id, unit.Id)))"
                              class="@($"produce produce-{unit.Id.Id}")">
                    <span class="produce-name">Build @Ruleset.UnitName(unit.Id)</span>
                    <CostLabel Amount="@unit.ProductionCost"/>
                </RadzenButton>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = null!;

    [Parameter, EditorRequired] public CityView City { get; set; } = null!;

    [Parameter, EditorRequired] public Ruleset Ruleset { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<GameCommand> Command { get; set; }

    private bool CanAct => View.Status == GameStatus.InProgress && View.CurrentPlayer == View.Viewer;

    private string ProductionText => City.Producing is { } type
        ? $"Producing a {Ruleset.UnitName(type)}: {City.ProductionProgress ?? 0} of {Ruleset.Unit(type).ProductionCost}"
        : "Producing nothing";
}
