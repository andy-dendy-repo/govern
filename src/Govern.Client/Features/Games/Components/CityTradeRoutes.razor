@* The trade routes of the player's own city, in its Market tab (G17): the routes it opened and the ones it hosts. Each says
   where it goes, how it stands and its deal as seen from this city. A proposal waiting at this city can be accepted (ticking
   older deals to cancel when the caps have no room; Accept says why it can't) or declined; a route this city opened gets the
   proposal form (TradeProposal) while it has no deal. Either side can cancel a deal; the owner can close the route. *@
@using Govern.Core.Actions
@using Govern.Core.Visibility

<RadzenStack Gap="0.5rem" class="trade-routes">
    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.H4" class="rz-m-0">Trade routes</RadzenText>
    @if (Routes.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="no-trade-routes rz-m-0">None. A Trader trained here opens one with Open route.</RadzenText>
    }
    @foreach (var route in Routes)
    {
        <RadzenStack Gap="0.25rem" class="@($"trade-route trade-route-{route.Id.Value}")">
            <RadzenText TextStyle="TextStyle.Body2" class="trade-route-title rz-m-0">@Title(route)</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="trade-route-status rz-m-0">@Status(route)</RadzenText>
            @if (Answerable(route))
            {
                @foreach (var other in Cancellable(route))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="cancel-to-make-room">
                        <RadzenCheckBox TValue="bool" Value="@Cancelling(route, other)" Change="@(on => Toggle(route, other, on))"
                                        Name="@($"cancel-{route.Id.Value}-{other.Id.Value}")" Disabled="@(Busy || !CanAct)"/>
                        <RadzenLabel Text="@($"Cancel the deal with {Partner(other)} to make room")" Component="@($"cancel-{route.Id.Value}-{other.Id.Value}")"/>
                    </RadzenStack>
                }
                var problem = TradePreviewCalculator.CheckAcceptDeal(Ruleset, View, route.Id, CancelList(route));
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Size="ButtonSize.Small" Text="Accept" Icon="handshake" Disabled="@(Busy || !CanAct || problem is not null)"
                                  Click="@(() => Command.InvokeAsync(new AnswerDealCommand(route.Id, true, CancelList(route))))" class="accept-deal"/>
                    <RadzenButton Size="ButtonSize.Small" Text="Decline" ButtonStyle="ButtonStyle.Light" Disabled="@(Busy || !CanAct)"
                                  Click="@(() => Command.InvokeAsync(new AnswerDealCommand(route.Id, false)))" class="decline-deal"/>
                    @if (problem is not null)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="accept-reason rz-m-0">@problem.Message</RadzenText>
                    }
                </RadzenStack>
            }
            @if (route.Owner == View.Viewer && route.Home == City.Id && route.Opened && !route.IsActive)
            {
                <TradeProposal @key="route.Id" View="@View" Ruleset="@Ruleset" Route="@route" Busy="@Busy" CanAct="@CanAct" Command="@Command"/>
            }
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                @if (route.Deal is not null)
                {
                    <RadzenButton Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Text="@(route.IsActive ? "Cancel deal" : "Withdraw proposal")"
                                  Disabled="@(Busy || !CanAct)" Click="@(() => Command.InvokeAsync(new CancelDealCommand(route.Id)))" class="cancel-deal"/>
                }
                @if (route.Owner == View.Viewer)
                {
                    <RadzenButton Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Text="Close route" Disabled="@(Busy || !CanAct)"
                                  Click="@(() => Command.InvokeAsync(new CloseTradeRouteCommand(route.Id)))" class="close-route"/>
                }
            </RadzenStack>
        </RadzenStack>
    }
</RadzenStack>
