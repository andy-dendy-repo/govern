@page "/register"
@using Govern.Client.Features.Users.Models

<PageTitle>Register - Govern</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Register</RadzenText>

<ApiErrorAlert Error="@_error"/>

<RadzenTemplateForm TItem="RegisterForm" Data="@_form" Submit="@SubmitAsync">
    <RadzenStack Gap="1rem" Style="max-width: 24rem">
        <RadzenFormField Text="Email">
            <RadzenTextBox Name="Email" @bind-Value="_form.Email" AutoCompleteType="AutoCompleteType.Email"/>
        </RadzenFormField>
        <RadzenRequiredValidator Component="Email" Text="Enter your email."/>
        <RadzenEmailValidator Component="Email" Text="Enter a valid email address."/>
        <RadzenFormField Text="Password">
            <RadzenPassword Name="Password" @bind-Value="_form.Password" AutoCompleteType="AutoCompleteType.NewPassword"/>
        </RadzenFormField>
        <RadzenLengthValidator Component="Password" Min="RegisterForm.PasswordMinLength" Max="RegisterForm.PasswordMaxLength"
                               Text="@PasswordLengthText"/>
        <RadzenFormField Text="Confirm password">
            <RadzenPassword Name="ConfirmPassword" @bind-Value="_form.ConfirmPassword" AutoCompleteType="AutoCompleteType.NewPassword"/>
        </RadzenFormField>
        <RadzenCompareValidator Component="ConfirmPassword" Value="@_form.Password" Text="The passwords do not match."/>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Register" IsBusy="@_busy"/>
        <RadzenLink Path="@LoginPath" Text="Already have an account? Sign in"/>
    </RadzenStack>
</RadzenTemplateForm>
