{
  "setup": {
    "players": 2,
    "startingUnits": ["settler", "soldier"]
  },
  "map": {
    "defaultWidth": 20,
    "defaultHeight": 14,
    "minSize": 8,
    "maxSize": 40,
    "defaultTerrain": "plains",
    "spawn": {
      "zoneColumnsPerMille": 250,
      "edgeMargin": 1
    },
    "generation": {
      "patches": [
        { "terrain": "forest", "sharePerMille": 150, "patchSize": 4 },
        { "terrain": "hills", "sharePerMille": 100, "patchSize": 3 },
        { "terrain": "mountains", "sharePerMille": 40, "patchSize": 2 },
        { "terrain": "lake", "sharePerMille": 40, "patchSize": 3 },
        { "terrain": "desert", "sharePerMille": 80, "patchSize": 7 }
      ],
      "rivers": {
        "count": 2,
        "minLength": 4,
        "maxLength": 12,
        "sources": ["hills", "mountains"],
        "mouths": ["lake"],
        "stages": [
          { "river": "stream", "fromSegment": 0 },
          { "river": "river", "fromSegment": 3 },
          { "river": "deep_river", "fromSegment": 7 }
        ]
      }
    }
  },
  "terrains": [
    { "id": "plains", "movementCost": 1, "isPassable": true, "sightBonus": 0, "defenceBonus": 0, "yields": [{ "resource": "food", "amount": 2 }, { "resource": "water", "amount": 1 }] },
    { "id": "forest", "movementCost": 2, "isPassable": true, "sightBonus": 0, "defenceBonus": 3, "yields": [{ "resource": "food", "amount": 1 }, { "resource": "water", "amount": 1 }, { "resource": "wood", "amount": 2 }] },
    { "id": "hills", "movementCost": 2, "isPassable": true, "sightBonus": 1, "defenceBonus": 3, "yields": [{ "resource": "food", "amount": 1 }, { "resource": "stone", "amount": 2 }] },
    { "id": "mountains", "movementCost": 1, "isPassable": false, "sightBonus": 0, "defenceBonus": 0, "yields": [{ "resource": "stone", "amount": 2 }] },
    { "id": "lake", "movementCost": 1, "isPassable": false, "sightBonus": 0, "defenceBonus": 0, "yields": [{ "resource": "food", "amount": 1 }, { "resource": "water", "amount": 3 }] },
    { "id": "desert", "movementCost": 1, "isPassable": true, "sightBonus": 0, "defenceBonus": 0, "yields": [] }
  ],
  "rivers": [
    { "id": "stream", "crossingCost": 0, "isCrossable": true, "defenceBonus": 0, "yields": [{ "resource": "water", "amount": 1 }] },
    { "id": "river", "crossingCost": 1, "isCrossable": true, "defenceBonus": 3, "yields": [{ "resource": "water", "amount": 1 }] },
    { "id": "deep_river", "crossingCost": 0, "isCrossable": false, "defenceBonus": 5, "yields": [{ "resource": "water", "amount": 1 }] }
  ],
  "bridges": {
    "cost": 6
  },
  "units": [
    { "id": "settler", "class": "civilian", "movement": 2, "sight": 2, "productionCost": 6, "abilities": ["found_city"] },
    { "id": "soldier", "class": "melee", "movement": 2, "sight": 2, "productionCost": 4, "strength": 20, "buildProduction": 1, "abilities": ["attack", "build_bridge"] },
    { "id": "spearman", "class": "anti_cavalry", "movement": 2, "sight": 2, "productionCost": 4, "strength": 18, "abilities": ["attack"] },
    { "id": "horseman", "class": "cavalry", "movement": 3, "sight": 3, "productionCost": 6, "strength": 20, "abilities": ["attack"] },
    { "id": "archer", "class": "ranged", "movement": 2, "sight": 2, "productionCost": 5, "strength": 10, "ranged": { "strength": 22, "range": 2 }, "abilities": ["ranged_attack"] },
    { "id": "builder", "class": "civilian", "movement": 2, "sight": 2, "productionCost": 5, "buildProduction": 2, "abilities": ["build_improvement", "build_bridge"] }
  ],
  "cities": {
    "sight": 2,
    "minimumSpacing": 3,
    "productionPerTurn": 1,
    "initialProduction": "soldier",
    "nameTemplate": "city.default_name",
    "captureResetsProduction": true,
    "yields": [{ "resource": "culture", "amount": 1 }],
    "startingStock": [{ "resource": "food", "amount": 5 }, { "resource": "water", "amount": 5 }, { "resource": "wood", "amount": 5 }, { "resource": "stone", "amount": 5 }]
  },
  "territory": {
    "initialRadius": 1,
    "maxRadius": 3,
    "growthResource": "culture",
    "tileCost": 4,
    "tileCostIncrease": 2
