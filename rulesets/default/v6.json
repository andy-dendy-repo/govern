    { "id": "farm", "terrains": ["plains"], "cost": 4, "yields": [{ "resource": "food", "amount": 2 }] },
    { "id": "lumber_camp", "terrains": ["forest"], "cost": 4, "yields": [{ "resource": "wood", "amount": 2 }] },
    { "id": "mine", "terrains": ["hills"], "cost": 6, "yields": [{ "resource": "stone", "amount": 2 }] }
