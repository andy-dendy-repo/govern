    "counters": [
      { "class": "melee", "against": "anti_cavalry", "bonus": 5 },
      { "class": "anti_cavalry", "against": "cavalry", "bonus": 10 },
      { "class": "cavalry", "against": "ranged", "bonus": 5 }
    ]
